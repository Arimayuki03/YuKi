{
  "name": "yuki",
  "version": "0.2.0",
  "description": "YuKi：影视聚合应用桌面端",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/download-binaries.js anime4k || exit 0",
    "backend": "python-backend\\.venv\\Scripts\\python.exe python-backend\\server.py",
    "smoke": "python-backend\\.venv\\Scripts\\python.exe python-backend\\tests\\smoke.py",
    "test:py": "python-backend\\.venv\\Scripts\\python.exe python-backend\\tests\\run_all.py",
    "test:js": "node scripts/check-js.js",
    "test:compat": "python-backend\\.venv\\Scripts\\python.exe python-backend\\tests\\test_config_compat.py",
    "lint": "eslint src tests scripts",
    "lint:py": "python-backend\\.venv\\Scripts\\ruff.exe check python-backend",
    "test:jsunit": "node scripts/run-jsunit.js",
    "test:all": "npm run test:py && npm run test:jsunit && npm run test:js && npm run lint && npm run lint:py",
    "build:py": "node scripts/build-python.js",
    "build:win": "npm run build:py && node scripts/download-binaries.js misans && electron-builder --win",
    "build:mac": "npm run build:py && node scripts/download-binaries.js misans && electron-builder --mac",
    "build:linux": "npm run build:py && node scripts/download-binaries.js misans && electron-builder --linux",
    "build": "npm run build:py && node scripts/download-binaries.js misans && electron-builder",
    "icons:tray": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\make-tray-icons.ps1"
  },
  "build": {
    "appId": "com.yuki.app",
    "productName": "YuKi",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "python-dist",
        "to": "python-backend"
      },
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*",
          "!**/.tmp/**",
          "!**/.tmp"
        ]
      }
    ],
    "files": [
        "src/**/*",
        "assets/**/*",
        "python-backend/**/*",
      "!python-backend/.venv/**",
      "!python-backend/__pycache__/**",
      "!python-backend/**/__pycache__/**",
      "!python-backend/**/*.pyc",
      "!python-backend/tests/**",
      "scripts/download-binaries.js",
      "scripts/binaries.lock.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "include": "build/installer.nsh",
      "shortcutName": "YuKi",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.8.1",
    "globals": "^17.11.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "license": "GPL-3.0-only"
}
